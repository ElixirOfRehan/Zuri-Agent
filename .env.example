# DeepSeek (required)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Models (current DeepSeek model names)
ZURI_BOSS_MODEL=deepseek-v4-pro
ZURI_WORKER_MODEL=deepseek-flash
ZURI_REFLECTOR_MODEL=deepseek-flash
ZURI_REFLECTION_ENABLED=1
ZURI_RESILIENCE_MODEL=deepseek-v4-pro
ZURI_OPENCODE_MODEL=deepseek/deepseek-v4-pro
ZURI_QA_ENABLED=1
ZURI_QA_MODEL=deepseek-v4-pro

# Public web tools (SSRF-filtered; localhost/private networks blocked)
ZURI_NETWORK_ENABLED=1
ZURI_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Engineering tool layer (runs with your user permissions)
ZURI_SHELL_ENABLED=1
ZURI_ALLOWED_COMMANDS=python,python3,py,node,npm,git,pytest,rea

# Optional free fallback chain (comma-separated; empty = disabled)
ZURI_FALLBACK_MODELS=

# Local paths
ZURI_DATA_DIR=./data
ZURI_WORKSPACE_DIR=./workspace
ZURI_LOG_LEVEL=INFO
